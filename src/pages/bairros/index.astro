---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Img from '../../components/Img.astro';
import { REGIAO } from '../../config';
import { BAIRROS, OUTROS_BAIRROS } from '../../data/bairros';

const ordenados = [...BAIRROS].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
---
<Base
  title="Bairros Atendidos: Mudança e Frete em Passo Fundo"
  description="Mudança, frete e carreto em todos os bairros de Passo Fundo: Centro, Boqueirão, São Cristóvão, Petrópolis, Vera Cruz e mais. Veja o seu bairro."
>
  <section class="hero-pagina">
    <div class="wrap">
      <nav class="migalhas" aria-label="Você está em"><a href="/">Início</a> / Bairros atendidos</nav>
      <h1>Bairros atendidos</h1>
      <p class="lead" style="margin-top:18px">Mudança residencial, comercial, frete, carreto e montagem de móveis em toda Passo Fundo. Escolha o bairro para ver os detalhes de lá.</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:72px">
    <ul class="bairros-lista">
      {ordenados.map((b) => <li><a href={`/bairros/${b.slug}/`}>{b.nome}</a></li>)}
    </ul>
    <h2 style="margin:56px 0 12px;font-size:clamp(1.6rem,3vw,2.2rem)">Também atendemos</h2>
    <p style="color:var(--suave);margin-bottom:20px">Fretes, carretos e mudanças nos demais bairros e setores de Passo Fundo, entre eles:</p>
    <p style="max-width:860px">{[...OUTROS_BAIRROS].sort((a, b) => a.localeCompare(b, 'pt-BR')).join(', ')}.</p>
    <p style="margin-top:20px;color:var(--suave)">Seu bairro não aparece? Atendemos a cidade inteira. É só chamar no WhatsApp.</p>
  </section>

  <section class="secao secao-preta">
    <div class="wrap dividido">
      <div>
        <h2>Cidades da região também.</h2>
        <p class="lead">Fretes e mudanças entre Passo Fundo e as cidades vizinhas, pela RS-324, BR-285 e BR-153.</p>
        <ul class="bairros-lista" style="margin-top:28px">
          {REGIAO.map((c) => <li><a href="/contato/">{c}</a></li>)}
        </ul>
      </div>
      <Img nome="cidade" alt="Estrada cortando lavouras vista de cima" />
    </div>
  </section>

  <Cta />
</Base>
