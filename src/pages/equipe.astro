---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Img from '../components/Img.astro';

const funcoes = [
  { img: 'equipe-atendimento', alt: 'Atendente com fone de ouvido sorrindo', titulo: 'Orçamento e agenda', texto: 'Recebe seu pedido no WhatsApp, entende o volume e o acesso, passa o valor e marca o dia e o horário.' },
  { img: 'equipe-motorista', alt: 'Motorista sorrindo dentro da van com o celular na mão', titulo: 'Motoristas', texto: 'Fazem o trajeto pela cidade e pelas rodovias da região, e prendem a carga para que nada se mova na estrada.' },
  { img: 'equipe-ajudantes', alt: 'Dois carregadores levando um sofá verde pela calçada', titulo: 'Carregadores', texto: 'Levam móveis e caixas por escadas, corredores e elevadores, sempre com manta e carrinho de carga.' },
  { img: 'equipe-montador', alt: 'Ferramentas de marcenaria sobre uma bancada', titulo: 'Montagem', texto: 'Desmontam roupeiros, camas e estantes, guardam as ferragens identificadas e montam tudo no novo endereço.' },
];
---
<Base
  title="Equipe de Mudanças e Fretes em Passo Fundo"
  description="As funções da equipe de mudanças e fretes em Passo Fundo: orçamento e agenda, motoristas, carregadores e montagem de móveis. Peça orçamento pelo WhatsApp."
  ogImage="equipe-ajudantes"
>
  <section class="hero-pagina">
    <div class="wrap">
      <nav class="migalhas" aria-label="Você está em"><a href="/">Início</a> / Equipe</nav>
      <h1>Quatro funções, uma mudança.</h1>
      <p class="lead" style="margin-top:18px">Cada etapa tem alguém responsável. É isso que faz o dia correr sem improviso.</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:96px">
    <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
      {funcoes.map((f) => (
        <div class="card">
          <Img nome={f.img} alt={f.alt} sizes="(max-width: 760px) 100vw, 25vw" />
          <h3>{f.titulo}</h3>
          <p>{f.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="secao secao-preta">
    <div class="texto">
      <h2>O que vale para todos</h2>
      <ul class="check" style="margin-top:28px;color:#e5e9f2">
        <li>Chegar no horário combinado.</li>
        <li>Proteger o móvel antes de tirar do lugar.</li>
        <li>Respeitar sua casa, seus vizinhos e as regras do prédio.</li>
        <li>Conferir com você, no fim, que tudo chegou e ficou onde devia.</li>
      </ul>
    </div>
  </section>

  <Cta />
</Base>
