---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import Img from '../../components/Img.astro';
import { linkWhatsapp } from '../../config';
import { SERVICOS, type Servico } from '../../data/servicos';
import { BAIRROS, OUTROS_BAIRROS } from '../../data/bairros';
import { md } from '../../lib/md';

const extras = import.meta.glob('../../data/servicos-extra/*.json', { eager: true }) as Record<string, { default: any }>;

export function getStaticPaths() {
  return SERVICOS.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Servico };
const extra = Object.entries(extras).find(([k]) => k.endsWith(`/${s.slug}.json`))?.[1].default ?? { secoes: [], faqExtra: [] };
const faqTodas = [...s.faq, ...(extra.faqExtra ?? [])];
const url = new URL(`/servicos/${s.slug}/`, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.h1,
    serviceType: s.nome,
    description: s.descricao,
    areaServed: { '@type': 'City', name: 'Curitiba' },
    provider: { '@id': new URL('/#empresa', Astro.site).href },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqTodas.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Serviços', item: new URL('/servicos/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: s.nome, item: url },
    ],
  },
];
const outros = SERVICOS.filter((o) => o.slug !== s.slug).slice(0, 3);
const mensagem = `Olá! Vim pelo site e quero um orçamento de ${s.nome.toLowerCase()} em Curitiba.`;
---
<Base title={s.title} description={s.descricao} schema={schema} ogImage={s.imagem}>
  <section class="hero-pagina">
    <div class="wrap">
      <nav class="migalhas" aria-label="Você está em"><a href="/">Início</a> / <a href="/servicos/">Serviços</a> / {s.nome}</nav>
      <h1>{s.h1}</h1>
      <p class="lead" style="margin-top:18px">{s.resumo}</p>
      <div class="acoes"><a class="btn" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener">Pedir orçamento no WhatsApp</a></div>
    </div>
  </section>
  <div class="post-capa"><Img nome={s.imagem} alt={s.imagemAlt} prioridade /></div>

  <section class="texto conteudo">
    {s.intro.map((p) => <p>{p}</p>)}

    <h2>O que está incluso</h2>
    <ul class="check">{s.inclui.map((i) => <li>{i}</li>)}</ul>

    <h2>{s.quando.titulo}</h2>
    <ul>{s.quando.itens.map((i) => <li>{i}</li>)}</ul>

    <h2>{s.dicas.titulo}</h2>
    <ul>{s.dicas.itens.map((i) => <li>{i}</li>)}</ul>

    {extra.secoes.map((sec: any) => (
      <>
        <h2>{sec.h2}</h2>
        {sec.paragrafos?.map((p: string) => <p set:html={md(p)} />)}
        {sec.lista && <ul>{sec.lista.map((i: string) => <li set:html={md(i)} />)}</ul>}
        {sec.tabela && (
          <div style="overflow-x:auto">
            <table>
              <thead><tr>{sec.tabela.cabecalho.map((c: string) => <th>{c}</th>)}</tr></thead>
              <tbody>{sec.tabela.linhas.map((l: string[]) => <tr>{l.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
            </table>
          </div>
        )}
      </>
    ))}

    <h2>{s.nome} em todos os bairros de Curitiba</h2>
    <p>Atendemos todos os bairros da cidade e a região metropolitana. Veja como funciona {s.principal ? `o serviço de ${s.nome.toLowerCase()}` : 'o atendimento'} no seu bairro:</p>
  </section>
  <div class="wrap" style="margin-top:20px">
    <ul class="bairros-lista">
      {BAIRROS.map((b) => <li><a href={`/bairros/${b.slug}/${s.principal ? `#${s.slug}` : ''}`}>{s.principal ? `${s.nome} ${b.prep} ${b.nome}` : b.nome}</a></li>)}
      <li><a href="/bairros/">Todos os bairros</a></li>
    </ul>
  </div>

  <section class="secao">
    <div class="texto">
      <h2 style="margin-bottom:28px">Perguntas frequentes</h2>
      <Faq itens={faqTodas} />
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="wrap">
      <div class="cabeca"><h2>Outros serviços</h2></div>
      <div class="cards">
        {outros.map((o) => (
          <a class="card" href={`/servicos/${o.slug}/`}>
            <Img nome={o.imagem} alt={o.imagemAlt} />
            <h3>{o.h1}</h3>
            <p>{o.resumo}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta mensagem={mensagem} />
</Base>
