---
import { SITE, linkWhatsapp, REGIAO } from '../config';
import { BAIRROS } from '../data/bairros';
import { SERVICOS } from '../data/servicos';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  ogType?: string;
  ogImage?: string;
  preloadImg?: string;
}

const { title, description, schema, ogType = 'website', ogImage = 'hero', preloadImg } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Marca no fim do título só quando cabe em 60 caracteres
const comMarca = `${title} | ${SITE.nome}`;
const fullTitle = title.includes(SITE.nome) || comMarca.length > 60 ? title : comMarca;
const imagemOg = new URL(`/images/${ogImage}.webp`, Astro.site).href;

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  '@id': new URL('/#empresa', Astro.site).href,
  name: SITE.nome,
  description: SITE.slogan,
  url: new URL('/', Astro.site).href,
  image: new URL('/images/hero.webp', Astro.site).href,
  areaServed: [{ '@type': 'City', name: 'Passo Fundo' }, ...REGIAO.map((c) => ({ '@type': 'City', name: c }))],
  openingHours: 'Mo-Sa 07:30-18:30',
  ...(SITE.telefone ? { telephone: SITE.telefone } : {}),
};
const schemas = [negocio, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];

const menu = [
  { href: '/servicos/', nome: 'Serviços' },
  { href: '/bairros/', nome: 'Bairros atendidos' },
  { href: '/quem-somos/', nome: 'Quem somos' },
  { href: '/equipe/', nome: 'Equipe' },
  { href: '/blog/', nome: 'Blog' },
  { href: '/contato/', nome: 'Contato' },
];
const atual = Astro.url.pathname;
const wa = linkWhatsapp();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImg && <link rel="preload" as="image" href={`/images/${preloadImg}.webp`} imagesrcset={`/images/${preloadImg}-800.webp 800w, /images/${preloadImg}.webp 1920w`} imagesizes="100vw" fetchpriority="high" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="topo">
      <div class="wrap topo-inner">
        <a href="/" class="marca" aria-label={`${SITE.nome}, página inicial`}>
          <span class="marca-sinal" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6.5" cy="17.5" r="1.8" fill="#ff7a1a"/><circle cx="17.5" cy="17.5" r="1.8" fill="#ff7a1a"/></svg>
          </span>
          <span>{SITE.nome}</span>
        </a>
        <nav aria-label="Menu principal">
          <ul class="menu">
            {menu.map((m) => <li><a href={m.href} aria-current={atual.startsWith(m.href) ? 'page' : undefined}>{m.nome}</a></li>)}
          </ul>
          <details class="menu-mobile">
            <summary>Menu</summary>
            <ul>
              <li><a href="/">Início</a></li>
              {menu.map((m) => <li><a href={m.href}>{m.nome}</a></li>)}
            </ul>
          </details>
        </nav>
        <a class="btn btn-sm" href={wa} target="_blank" rel="noopener">Orçamento</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="rodape">
      <div class="wrap">
        <div class="rodape-grade">
          <div>
            <a href="/" class="marca">
              <span class="marca-sinal" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/></svg>
              </span>
              <span>{SITE.nome}</span>
            </a>
            <p>{SITE.slogan}.</p>
            <p>{SITE.horario}</p>
            <p><a href={wa} target="_blank" rel="noopener">Orçamento pelo WhatsApp</a></p>
          </div>
          <div>
            <p class="rodape-titulo">Serviços</p>
            <ul>{SERVICOS.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}</ul>
          </div>
          <div>
            <p class="rodape-titulo">Bairros</p>
            <ul>
              {BAIRROS.slice(0, 5).map((b) => <li><a href={`/bairros/${b.slug}/`}>{b.nome}</a></li>)}
              <li><a href="/bairros/">Todos os bairros</a></li>
            </ul>
          </div>
          <div>
            <p class="rodape-titulo">Empresa</p>
            <ul>
              <li><a href="/quem-somos/">Quem somos</a></li>
              <li><a href="/equipe/">Equipe</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contato/">Contato</a></li>
            </ul>
          </div>
        </div>
        <div class="rodape-fim">
          <span>© {new Date().getFullYear()} {SITE.nome}. Passo Fundo, RS.</span>
          <span>Fotos: Pexels</span>
        </div>
      </div>
    </footer>

    <a class="whats" href={wa} target="_blank" rel="noopener" aria-label="Pedir orçamento pelo WhatsApp">
      <span class="whats-icone" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="18" height="18"><path fill="#fff" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3 29l7.3-1.9c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.7 12.7-12.6C28.7 8.6 23 3 16 3zm5.8 15.4c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.6-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.9-.8 2.1-1.5.3-.7.3-1.3.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
      </span>
      <span class="whats-texto">Orçamento</span>
    </a>
  </body>
</html>
